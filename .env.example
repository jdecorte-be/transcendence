# Copy this file to .env and fill in real values.
# docker-compose.yml / docker-compose-dev.yaml read this file automatically.

# --- Database (backend + migration service) ---
# Local dev (docker-compose-dev.yaml) Postgres user/db default to "postgres",
# password is hardcoded there to "test" — match it if you use that compose file.
DATABASE_URL=postgresql://postgres:test@database:5432/transcendence?schema=public

# --- Auth tokens (backend) ---
# Long random strings, e.g. `openssl rand -hex 32`
AT_SECRET=changeme_access_token_secret
RT_SECRET=changeme_refresh_token_secret

# --- CORS (backend) ---
# Comma-separated list of allowed origins, no trailing slash
CORS_ORIGIN=http://localhost:3000
WS_CORS_ORIGIN=http://localhost:3000

# --- Frontend URL used for OAuth redirects / cookie flags (backend) ---
FRONT_URL=http://localhost:3000

# --- Session cookie options (backend, optional) ---
# COOKIE_DOMAIN=localhost
# COOKIE_SECURE=false

# --- Node environment (backend) ---
NODE_ENV=development

# --- 42 (ft) OAuth app (backend) ---
FT_CLIENT_ID=changeme
FT_CLIENT_SECRET=changeme
FT_CALLBACK_URL=http://localhost:3001/auth/42/callback

# --- GitHub OAuth app (backend) ---
GITHUB_CLIENT_ID=changeme
GITHUB_CLIENT_SECRET=changeme
GITHUB_CALLBACK_URL=http://localhost:3001/auth/github/callback

# --- Cloudinary (backend, avatar uploads) ---
CLD_CLOUD_NAME=changeme
CLD_API_KEY=changeme
CLD_API_SECRET=changeme

# --- Frontend build-time vars (baked in by nginx/Dockerfile at build time) ---
REACT_APP_API_ENDPOINT=http://localhost:3001
REACT_APP_SOCKET_ENDPOINT=http://localhost:3001
REACT_APP_AUTH_PATH=http://localhost:3001/auth/42
REACT_APP_GITHUB_AUTH_PATH=http://localhost:3001/auth/github
REACT_APP_LOGOUT=http://localhost:3001/auth/logout
